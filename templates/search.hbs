<div class="pocket-rule">

  <div class="pocket-rule-search-row">

    <div class="pocket-rule-search-box">
      <i class="fa-solid fa-magnifying-glass pocket-rule-search-icon"></i>

      <input
        id="pocket-rule-search-input"
        class="pocket-rule-search-input"
        type="search"
        name="ruleSearch"
        placeholder="Search rules..."
        autocomplete="off"
        spellcheck="false"
        autofocus
      >
    </div>

  </div>

  <div class="pocket-rule-results" data-pocket-rule-results>

    <div class="pocket-rule-welcome">
      <i class="fa-solid fa-book-open pocket-rule-welcome-icon"></i>

      <div class="pocket-rule-welcome-title">
        Pocket Rule
      </div>

      <div class="pocket-rule-welcome-text">
        Type a rule, condition, action, or keyword.
      </div>
    </div>

  </div>

  <div class="pocket-rule-footer">
    <span>
      Rules Reference
    </span>

    <span class="pocket-rule-footer-separator">
      •
    </span>

    <span>
      SRD 5.2
    </span>
  </div>

</div>
